MONGODB_URI=

SESSION_SECRET=

# Used ONLY to create the first admin when no admin exists. Remove after first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
PORT=3000

EXECUTION_ENABLED=false
# Compiler options. Runs are open to all visitors but rate-limited per IP; set EXEC_ADMIN_ONLY=true to restrict to admins.
EXEC_PER_MIN=10
EXEC_ADMIN_ONLY=true
# Optional: folder for uploaded files. On hosts with temporary disks, point this at a persistent volume (e.g. /var/data/uploads).
#UPLOAD_DIR=
# REQUIRED for permanent uploads on hosts with temporary disks (Render/Railway/Heroku etc.).
# Get it from Cloudinary dashboard -> API Keys. Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
#CLOUDINARY_URL=
CLOUDINARY_URL=
MONGODB_DB=
